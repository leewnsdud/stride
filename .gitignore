# Public source allowlist. Keep local records and working notes out of Git.
/*
!/.gitignore
!/.nvmrc
!/.env.example
!/package.json
!/package-lock.json
!/requirements.txt
!/index.html
!/vite.config.js
!/README.md
!/LICENSE
!/NOTICE.md
!/SECURITY.md
!/CONTRIBUTING.md
!/src/
!/server/
!/shared/
!/tests/
!/scripts/
!/skills/
!/worker/
!/public/
!/.github/
!/docs/
/docs/*
!/docs/INSTALL.ko.md
!/docs/PRIVACY.ko.md
# Never commit runtime state, credentials, backups or exported user records.
**/node_modules/
**/data/
**/dist/
**/.venv/
**/__pycache__/
**/.env
**/.env.*
!/.env.example
**/.DS_Store
**/*.log
**/*.sqlite*
**/*.db
**/*.db-*
**/*.fit
**/*.gpx
**/*.tcx
**/*.har
**/*.pem
**/*.key
**/auth.json
**/*tokens*.json
**/remote-access.json
**/integrations.json
